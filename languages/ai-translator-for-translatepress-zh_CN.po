#. Plugin Name of the plugin
#: ai-translator-for-translatepress.php
#: includes/wp/class-aitp-admin.php:215
msgid "AI Translator for TranslatePress"
msgstr "AI Translator for TranslatePress"

#. Plugin URI of the plugin
#: ai-translator-for-translatepress.php
msgid "https://github.com/alankongx/ai-translator-for-translatepress"
msgstr "https://github.com/alankongx/ai-translator-for-translatepress"

#. Description of the plugin
#: ai-translator-for-translatepress.php
msgid "Translation engine for TranslatePress using Google Gemini or any OpenAI-compatible API. Translations are mapped by ID and validated before TranslatePress saves them; failed strings stay untranslated and are retried later instead of being saved wrong."
msgstr "TranslatePress 的翻译引擎，支持 Google Gemini 和任意 OpenAI 兼容接口。译文按编号对应，并在 TranslatePress 保存前逐条校验；校验不过的文字保持未翻译、稍后重试，绝不存错。"

#. Author of the plugin
#: ai-translator-for-translatepress.php
msgid "alankongx"
msgstr "alankongx"

#. Author URI of the plugin
#: ai-translator-for-translatepress.php
msgid "https://github.com/alankongx"
msgstr "https://github.com/alankongx"

#: includes/wp/class-aitp-admin.php:54
#: includes/wp/class-aitp-admin.php:169
msgid "AI Translator"
msgstr "AI 翻译"

#: includes/wp/class-aitp-admin.php:76
#: includes/wp/class-aitp-admin.php:208
msgid "Settings"
msgstr "设置"

#: includes/wp/class-aitp-admin.php:106
msgid "AI Translator for TranslatePress needs the TranslatePress plugin to be installed and active."
msgstr "AI Translator for TranslatePress 需要先安装并启用 TranslatePress 插件。"

#: includes/wp/class-aitp-admin.php:110
msgid "The plugin \"HHG for TranslatePress\" is also active. Only one translation engine is used at a time (TranslatePress → Automatic Translation → engine). Deactivate HHG after switching to AI Translator to avoid confusion."
msgstr "「HHG for TranslatePress」插件也处于启用状态。TranslatePress 同一时间只用一个翻译引擎（TranslatePress → 自动翻译 → 引擎）。切换到 AI 翻译后请停用 HHG，以免混淆。"

#: includes/wp/class-aitp-admin.php:113
msgid "AI Translator: the saved API key can no longer be read (the site's secret keys in wp-config.php changed). Please enter the API key again."
msgstr "AI 翻译：已保存的 API 密钥无法读取（wp-config.php 里的站点密钥变了）。请重新填写 API 密钥。"

#: includes/wp/class-aitp-admin.php:113
msgid "Open settings"
msgstr "打开设置"

#: includes/wp/class-aitp-admin.php:118
msgid "AI Translator has paused automatic translation."
msgstr "AI 翻译已暂停自动翻译。"

#: includes/wp/class-aitp-admin.php:118
#: includes/wp/class-aitp-admin.php:505
msgid "Details"
msgstr "详情"

#: includes/wp/class-aitp-admin.php:144
msgid "The API key was rejected. Check the key and the API address."
msgstr "API 密钥被拒绝。请检查密钥和接口地址。"

#: includes/wp/class-aitp-admin.php:145
msgid "The provider reports a billing or balance problem. Top up or check the account."
msgstr "服务商提示账单或余额有问题。请充值或检查账户。"

#: includes/wp/class-aitp-admin.php:146
msgid "The model or API address was not found. Check the model name."
msgstr "找不到模型或接口地址。请检查模型名称。"

#: includes/wp/class-aitp-admin.php:147
msgid "The provider rejected the requests as invalid. Check the model and settings, then run the connection test."
msgstr "服务商认为请求无效。请检查模型和设置，然后运行连接测试。"

#: includes/wp/class-aitp-admin.php:148
msgid "Rate limit reached; requests resume automatically."
msgstr "已达到频率上限，稍后自动恢复。"

#: includes/wp/class-aitp-admin.php:149
msgid "The provider's daily quota is used up; requests resume automatically later."
msgstr "服务商当天额度已用完，稍后自动恢复。"

#: includes/wp/class-aitp-admin.php:150
msgid "The provider returned server errors; requests resume automatically."
msgstr "服务商返回服务器错误，稍后自动恢复。"

#: includes/wp/class-aitp-admin.php:151
msgid "Requests timed out; requests resume automatically."
msgstr "请求超时，稍后自动恢复。"

#: includes/wp/class-aitp-admin.php:152
msgid "Network error while contacting the provider."
msgstr "连接服务商时网络出错。"

#: includes/wp/class-aitp-admin.php:153
msgid "The provider returned an unreadable response."
msgstr "服务商返回的内容无法读取。"

#: includes/wp/class-aitp-admin.php:154
msgid "The model's answers were repeatedly cut off, unreadable or misaligned, so they were discarded; requests resume automatically."
msgstr "模型的回答接连被截断、无法读取或对位错乱，已全部丢弃；稍后自动恢复。"

#: includes/wp/class-aitp-admin.php:171
msgid "Not configured yet."
msgstr "尚未配置。"

#: includes/wp/class-aitp-admin.php:177
msgid "Open AI Translator settings"
msgstr "打开 AI 翻译设置"

#: includes/wp/class-aitp-admin.php:178
msgid "The daily character limit above also applies to AI Translator (sent characters, retries included)."
msgstr "上方的每日字符上限同样适用于 AI 翻译（按发送的字符计，含重试）。"

#: includes/wp/class-aitp-admin.php:189
msgid "paused"
msgstr "已暂停"

#: includes/wp/class-aitp-admin.php:192
msgid "waiting (temporary)"
msgstr "等待中（临时）"

#: includes/wp/class-aitp-admin.php:194
msgid "running"
msgstr "运行中"

#: includes/wp/class-aitp-admin.php:209
msgid "Status & log"
msgstr "状态与日志"

#: includes/wp/class-aitp-admin.php:210
msgid "Review list"
msgstr "待复核列表"

#: includes/wp/class-aitp-admin.php:240
msgid "To use this engine, open TranslatePress → Settings → Automatic Translation, turn automatic translation on and choose \"AI Translator\" as the engine."
msgstr "要使用这个引擎，请打开 TranslatePress → 设置 → 自动翻译，开启自动翻译并把引擎选为「AI Translator」。"

#: includes/wp/class-aitp-admin.php:251
msgid "Connection"
msgstr "连接"

#: includes/wp/class-aitp-admin.php:253
msgid "API type"
msgstr "接口类型"

#: includes/wp/class-aitp-admin.php:254
msgid "Google Gemini (native API)"
msgstr "Google Gemini（原生接口）"

#: includes/wp/class-aitp-admin.php:254
msgid "OpenAI-compatible API (OpenAI, DeepSeek, Zhipu, OpenRouter, relays …)"
msgstr "OpenAI 兼容接口（OpenAI、DeepSeek、智谱、OpenRouter、中转站等）"

#: includes/wp/class-aitp-admin.php:259
msgid "Service"
msgstr "服务"

#: includes/wp/class-aitp-admin.php:265
msgid "API address"
msgstr "接口地址"

#: includes/wp/class-aitp-admin.php:266
msgid "Leave empty to use the default address of the selected service. HTTPS only. For relays, enter the address that ends before /chat/completions (often ending in /v1)."
msgstr "留空则使用所选服务的默认地址。只接受 HTTPS。中转站请填到 /chat/completions 之前的部分（通常以 /v1 结尾）。"

#: includes/wp/class-aitp-admin.php:268
msgid "API key"
msgstr "API 密钥"

#: includes/wp/class-aitp-admin.php:270
msgid "Set in wp-config.php (AITP_API_KEY)."
msgstr "已在 wp-config.php 中设置（AITP_API_KEY）。"

#. translators: %s: last 4 characters
#: includes/wp/class-aitp-admin.php:272
msgid "Saved (…%s) — enter a new key to replace it"
msgstr "已保存（…%s）——填写新密钥即可替换"

