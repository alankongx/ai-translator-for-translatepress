msgstr "已在 wp-config.php 中设置（AITP_API_KEY）。"

#. translators: %s: last 4 characters
#: includes/wp/class-aitp-admin.php:287
msgid "Saved (…%s) — enter a new key to replace it"
msgstr "已保存（…%s）——填写新密钥即可替换"

