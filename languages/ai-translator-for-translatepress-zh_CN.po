msgid "Model default"
msgstr "模型默认"

#: includes/wp/class-aitp-admin.php:314
msgid "Structured output"
msgstr "结构化输出"

#: includes/wp/class-aitp-admin.php:315
msgid "Automatic (schema → JSON → plain, chosen by what the API accepts)"
msgstr "自动（按接口支持情况依次用 schema → JSON → 纯文本）"

#: includes/wp/class-aitp-admin.php:315
msgid "JSON mode only"
msgstr "仅 JSON 模式"

#: includes/wp/class-aitp-admin.php:315
