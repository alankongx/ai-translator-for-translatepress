#. Plugin Name of the plugin
#: ai-translator-for-translatepress.php
#: includes/wp/class-aitp-admin.php:228
msgid "AI Translator for TranslatePress"
msgstr "AI Translator for TranslatePress"

#. Plugin URI of the plugin
#: ai-translator-for-translatepress.php
msgid "https://github.com/alankongx/ai-translator-for-translatepress"
msgstr "https://github.com/alankongx/ai-translator-for-translatepress"

#. Description of the plugin
#: ai-translator-for-translatepress.php
msgid "Translation engine for TranslatePress using Google Gemini or any OpenAI-compatible API. Translations are mapped by ID and validated before TranslatePress saves them; failed strings stay untranslated and are retried later instead of being saved wrong."
msgstr "TranslatePress 的翻译引擎，支持 Google Gemini 和任意 OpenAI 兼容接口。译文按编号对应，并在 TranslatePress 保存前逐条校验；校验不过的文字保持未翻译、稍后重试，绝不存错。"

#. Author of the plugin
#: ai-translator-for-translatepress.php
msgid "alankongx"
msgstr "alankongx"

#. Author URI of the plugin
#: ai-translator-for-translatepress.php
msgid "https://github.com/alankongx"
msgstr "https://github.com/alankongx"

#: includes/wp/class-aitp-admin.php:55
#: includes/wp/class-aitp-admin.php:181
msgid "AI Translator"
msgstr "AI 翻译"

#: includes/wp/class-aitp-admin.php:77
#: includes/wp/class-aitp-admin.php:220
msgid "Settings"
msgstr "设置"

#: includes/wp/class-aitp-admin.php:118
msgid "AI Translator for TranslatePress needs the TranslatePress plugin to be installed and active."
msgstr "AI Translator for TranslatePress 需要先安装并启用 TranslatePress 插件。"

#: includes/wp/class-aitp-admin.php:122
msgid "The plugin \"HHG for TranslatePress\" is also active. Only one translation engine is used at a time (TranslatePress → Automatic Translation → engine). Deactivate HHG after switching to AI Translator to avoid confusion."
msgstr "「HHG for TranslatePress」插件也处于启用状态。TranslatePress 同一时间只用一个翻译引擎（TranslatePress → 自动翻译 → 引擎）。切换到 AI 翻译后请停用 HHG，以免混淆。"

#: includes/wp/class-aitp-admin.php:125
msgid "AI Translator: the saved API key can no longer be read (the site's secret keys in wp-config.php changed). Please enter the API key again."
msgstr "AI 翻译：已保存的 API 密钥无法读取（wp-config.php 里的站点密钥变了）。请重新填写 API 密钥。"

